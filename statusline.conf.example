# Ajustes locais da status line. Copie para ~/.claude/statusline.conf e edite.
# Este arquivo é lido no início do statusline.sh; nada aqui vai para o repositório.

# Cor do perfil GCP ativo (☁), por prefixo do nome do perfil.
# Cores: orange ice blue green mauve pink teal peach sky yellow red
PROFILE_COLORS="acme=orange outracorp=ice"

# Prefixo a remover do nome do contexto kubectl (⎈), quando ele repete a empresa.
# Ex.: contexto "acme-ctx-core-prod" aparece como "core-prod".
KCTX_STRIP_PREFIX="acme-ctx-"
