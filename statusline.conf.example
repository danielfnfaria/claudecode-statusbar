# Local settings for the status line. Copy to ~/.claude/statusline.conf and edit.
# This file is read at the start of statusline.sh; nothing here goes into the repository.

# Color of the active GCP profile (☁), by profile name prefix.
# Colors: orange ice blue green mauve pink teal peach sky yellow red
PROFILE_COLORS="acme=orange outracorp=ice"

# Agent map (the panel of active sub-agents). AGENT_MAP=off turns it off entirely:
# no python runs and no image is sent to the terminal.
AGENT_MAP=on
